<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LensCraft.Views.FlashOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False">

    <UserControl.Resources>
        <!-- Spec §3: full-window white, 0 → 80% → 0 opacity in 250 ms. -->
        <Storyboard x:Name="FlashStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FlashRect" Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.08" Value="0.8" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>

    <Rectangle x:Name="FlashRect"
               Fill="{StaticResource CaptureWhiteBrush}"
               Opacity="0" />
</UserControl>
