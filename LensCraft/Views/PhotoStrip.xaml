<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LensCraft.Views.PhotoStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:LensCraft.Models">

    <UserControl.Resources>
        <Storyboard x:Name="SlideUpStoryboard">
            <DoubleAnimation Storyboard.TargetName="StripTransform"
                             Storyboard.TargetProperty="Y"
                             To="0"
                             Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Name="SlideDownStoryboard">
            <DoubleAnimation Storyboard.TargetName="StripTransform"
                             Storyboard.TargetProperty="Y"
                             To="52"
                             Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <!-- Spec §3: last 6 captures as 64 px rounded thumbnails. Rests mostly below the window edge
         and slides up on hover. Click a thumbnail to open the file. -->
    <Grid x:Name="StripRoot"
          Background="Transparent"
          PointerEntered="OnStripPointerEntered"
          PointerExited="OnStripPointerExited"
          Visibility="{x:Bind ViewModel.HasRecentPhotos, Mode=OneWay}">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="StripTransform" Y="52" />
        </Grid.RenderTransform>

        <Border Padding="8,8,8,12"
                CornerRadius="16,16,0,0"
                Style="{StaticResource FloatingPillStyle}">
            <ItemsControl ItemsSource="{x:Bind ViewModel.RecentPhotos, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:CapturedPhoto">
                        <Button Width="64"
                                Height="64"
                                Padding="0"
                                AutomationProperties.Name="{x:Bind Name}"
                                BorderThickness="0"
                                Click="OnThumbnailClick"
                                CornerRadius="8"
                                ToolTipService.ToolTip="{x:Bind Name}">
                            <Border Width="64" Height="64" CornerRadius="8">
                                <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill" />
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</UserControl>
