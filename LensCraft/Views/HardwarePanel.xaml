<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LensCraft.Views.HardwarePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LensCraft.Views"
    xmlns:models="using:LensCraft.Models"
    Width="320">

    <UserControl.Resources>
        <Storyboard x:Name="SlideInStoryboard">
            <DoubleAnimation Storyboard.TargetName="PanelTransform"
                             Storyboard.TargetProperty="X"
                             To="0"
                             Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Name="SlideOutStoryboard">
            <DoubleAnimation Storyboard.TargetName="PanelTransform"
                             Storyboard.TargetProperty="X"
                             To="340"
                             Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Spec §5 row: label left (12 px), value right (13 px Consolas), optional detail line. -->
        <DataTemplate x:Key="InfoRowTemplate" x:DataType="models:HardwareInfoRow">
            <Grid Padding="0,5" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Top"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind Label}" />
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock FontFamily="Consolas"
                               FontSize="13"
                               IsTextSelectionEnabled="True"
                               Text="{x:Bind Text, Mode=OneWay}"
                               TextAlignment="Right"
                               TextWrapping="Wrap" />
                    <TextBlock FontFamily="Consolas"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind Detail, Mode=OneWay}"
                               TextAlignment="Right"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind HasDetail, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="PanelRoot" Visibility="Collapsed">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="PanelTransform" X="340" />
        </Grid.RenderTransform>

        <Border Padding="16,12,8,12"
                CornerRadius="12"
                Style="{StaticResource FloatingPillStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header: title, copy, close -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Text="Camera details" />
                    <Button Grid.Column="1"
                            Width="36"
                            Height="36"
                            AutomationProperties.Name="Copy camera details"
                            Command="{x:Bind ViewModel.CopyHardwareInfoCommand, Mode=OneWay}"
                            CornerRadius="18"
                            Style="{StaticResource PillIconButtonStyle}"
                            ToolTipService.ToolTip="Copy as text">
                        <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                    </Button>
                    <Button Grid.Column="2"
                            Width="36"
                            Height="36"
                            AutomationProperties.Name="Close camera details"
                            Click="OnCloseClick"
                            CornerRadius="18"
                            Style="{StaticResource PillIconButtonStyle}"
                            ToolTipService.ToolTip="Close">
                        <FontIcon FontSize="14" Glyph="&#xE711;" />
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" Padding="0,0,8,0">
                    <StackPanel Spacing="16">

                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="No camera is running."
                                   TextWrapping="Wrap"
                                   Visibility="{x:Bind local:UiConverters.VisibleIfNone(ViewModel.IdentityRows.Count), Mode=OneWay}" />

                        <!-- Identity: DeviceInformation -->
                        <StackPanel Visibility="{x:Bind local:UiConverters.VisibleIfAny(ViewModel.IdentityRows.Count), Mode=OneWay}">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Identity" />
                            <ItemsControl ItemTemplate="{StaticResource InfoRowTemplate}" ItemsSource="{x:Bind ViewModel.IdentityRows, Mode=OneWay}" />
                        </StackPanel>

                        <!-- Active format: GetMediaStreamProperties -->
                        <StackPanel Visibility="{x:Bind local:UiConverters.VisibleIfAny(ViewModel.ActiveFormatRows.Count), Mode=OneWay}">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Active format" />
                            <ItemsControl ItemTemplate="{StaticResource InfoRowTemplate}" ItemsSource="{x:Bind ViewModel.ActiveFormatRows, Mode=OneWay}" />
                        </StackPanel>

                        <!-- Capabilities: GetAvailableMediaStreamProperties (count + expandable list) -->
                        <StackPanel Spacing="6" Visibility="{x:Bind local:UiConverters.VisibleIfAny(ViewModel.Formats.Count), Mode=OneWay}">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Capabilities" />
                            <Expander HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      Header="{x:Bind local:UiConverters.FormatCount(ViewModel.Formats.Count), Mode=OneWay}">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Formats, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:CameraFormat">
                                            <Grid Padding="0,3" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontFamily="Consolas" FontSize="12" Text="{x:Bind ResolutionText}" />
                                                <TextBlock Grid.Column="1"
                                                           FontFamily="Consolas"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           Text="{x:Bind DetailText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </StackPanel>

                        <!-- Controls: VideoDeviceController.<Control>.Capabilities, supported ones only -->
                        <StackPanel Visibility="{x:Bind local:UiConverters.VisibleIfAny(ViewModel.ControlRows.Count), Mode=OneWay}">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Controls" />
                            <ItemsControl ItemTemplate="{StaticResource InfoRowTemplate}" ItemsSource="{x:Bind ViewModel.ControlRows, Mode=OneWay}" />
                        </StackPanel>

                        <!-- Session: MediaFrameReader frame counter, 1 s average -->
                        <StackPanel Visibility="{x:Bind local:UiConverters.VisibleIfAny(ViewModel.SessionRows.Count), Mode=OneWay}">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Session" />
                            <ItemsControl ItemTemplate="{StaticResource InfoRowTemplate}" ItemsSource="{x:Bind ViewModel.SessionRows, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
