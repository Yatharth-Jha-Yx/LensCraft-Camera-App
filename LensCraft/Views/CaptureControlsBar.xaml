<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LensCraft.Views.CaptureControlsBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Spec §3: bottom-center pill. Filter toggle (left), capture (center), mirror toggle (right). -->
    <Border Padding="10,8" Style="{StaticResource FloatingPillStyle}">
        <StackPanel Orientation="Horizontal" Spacing="20">

            <!-- Filter strip toggle: enabled in Phase 3 together with EffectsService. -->
            <Button VerticalAlignment="Center"
                    AutomationProperties.Name="Filters"
                    IsEnabled="False"
                    Style="{StaticResource PillIconButtonStyle}">
                <FontIcon FontSize="18" Glyph="&#xE790;" />
            </Button>

            <!-- Shutter: white ring with a white center, like Photo Booth. -->
            <Button x:Name="CaptureButton"
                    Width="64"
                    Height="64"
                    AutomationProperties.Name="Take photo"
                    Command="{x:Bind ViewModel.CapturePhotoCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="Take photo">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="ShutterRoot" Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="InnerDot.Opacity" Value="0.85" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="InnerDot.Margin" Value="11" />
                                            <Setter Target="InnerDot.Opacity" Value="0.7" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="ShutterRoot.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Ellipse Stroke="{StaticResource CaptureWhiteBrush}" StrokeThickness="4" />
                            <Ellipse x:Name="InnerDot"
                                     Margin="8"
                                     Fill="{StaticResource CaptureWhiteBrush}" />
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <ToggleButton VerticalAlignment="Center"
                          AutomationProperties.Name="Mirror preview"
                          IsChecked="{x:Bind ViewModel.IsPreviewMirrored, Mode=TwoWay}"
                          Style="{StaticResource PillIconToggleButtonStyle}"
                          ToolTipService.ToolTip="Mirror preview">
                <FontIcon FontSize="18" Glyph="&#xE8AB;" />
            </ToggleButton>
        </StackPanel>
    </Border>
</UserControl>
